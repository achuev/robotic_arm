# URL, который зашивается в QR-код на лендинге.
# Должен быть тем адресом, по которому телефон прохожего откроет /control.
# Если не задан — лендинг подставит `${location.origin}/control`.
VITE_PUBLIC_URL=http://so101.local/control

# Базовый адрес шлюза. Пусто = тот же origin (в dev работает vite-прокси на мок-сервер).
VITE_API_BASE=

# Явный адрес WebSocket. Пусто = ws(s)://<origin>/ws
VITE_WS_URL=
