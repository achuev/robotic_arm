# Настройки стенда, которые меняют на месте. Читается docker compose
# автоматически (файл лежит рядом с compose-файлами). После правки:
#
#     docker compose -f deploy/compose.prod.yml up -d gateway web camera
#
# ─────────────────────────────────────────────────────────────────────────
# КАМЕРА В САЙТЕ
# ─────────────────────────────────────────────────────────────────────────
# Выключена. Картинку посетитель видит на отдельном экране рядом с рукой:
#
#     http://<ip стенда>:8080/screen/
#
# а в самом сайте её заменяет 3D-модель — она рисуется по joint_states и
# идёт тем же WebSocket, что и управление, то есть почти даром.
#
# ПОЧЕМУ ТАК. MJPEG отдаётся КАЖДОМУ смотрящему собственным потоком, около
# 2.9 Мбит/с на человека, и все они уходят через исходящий канал зала. На
# сотовом модеме этот канал 2–15 Мбит/с вверх — видео забирает его целиком
# и роняет управление, ради которого стенд существует. Экран у стенда берёт
# поток по локальной сети, где он не стоит ничего.
#
# Включить обратно (сначала прочитайте docs/public-access.md):
#     FEATURE_VIDEO=1
FEATURE_VIDEO=0

# ─────────────────────────────────────────────────────────────────────────
# КАЧЕСТВО ВИДЕО
# ─────────────────────────────────────────────────────────────────────────
# Пока FEATURE_VIDEO=0, эти значения кормят только экран у стенда — он в
# локальной сети, и экономить незачем. Полное разрешение и есть верный
# выбор.
CAM_WIDTH=640
CAM_HEIGHT=480
CAM_FPS=15.0
VIDEO_QUALITY=70

# Значения ниже нужны, только если вы ВКЛЮЧИЛИ видео в сайте и оно должно
# пройти через узкий канал. Замерено на этой машине, кбит/с на зрителя:
#
#     разрешение     fps   q70    q50    q40    q30
#     640x480        15    2808   2281   2037   1791
#     640x480        10    1912   1519   1364   1199
#     480x360        10    1530   1192   1076    944
#     480x360         8    1210    954    857    755
#     320x240         8     834    658    593    518
#
# Качество даёт меньше, чем принято думать: срезает четверть. Работают
# разрешение и частота кадров.
#
#   сотовый модем:  CAM_WIDTH=480  CAM_HEIGHT=360  CAM_FPS=8.0  VIDEO_QUALITY=50
#   слабая связь:   CAM_WIDTH=320  CAM_HEIGHT=240  CAM_FPS=8.0  VIDEO_QUALITY=40
