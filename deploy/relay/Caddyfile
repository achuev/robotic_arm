# Ретранслятор SO-101: публичная точка входа на арендованном сервере.
#
# Стенд стоит в зале за NAT и сам дозванивается до этого сервера по WireGuard.
# Наружу торчит только Caddy: он терминирует TLS и проксирует всё на стенд
# через туннель. Пока туннель опущен — сервер физически не имеет маршрута до
# стенда, и посетитель видит страницу «стенд сейчас выключен», а не ошибку.
#
# Адрес сайта берётся из переменной окружения:
#   SO101_SITE=arm.example.ru   боевой режим, сертификат выпишется сам
#   SO101_SITE=:80              локальная отладка без TLS
#
# Куда проксировать — тоже переменной, чтобы этот же файл годился для
# локальной репетиции без туннеля:
#   SO101_UPSTREAM=10.8.0.2:8080    стенд через WireGuard
#   SO101_UPSTREAM=host.docker.internal:8080   локальная отладка

{
	# Почта для Let's Encrypt: на неё придёт письмо, если сертификат вдруг
	# перестанет обновляться. Без неё выпуск тоже работает, но молча.
	email {$SO101_ACME_EMAIL:admin@example.com}
	# Логи в stdout: сервер живёт в systemd/docker, туда и смотрим.
	log {
		output stdout
		format console
	}
	# Обычно h1 h2 h3. Сводится к «h1 h2», если 443/udp пришлось отдать
	# WireGuard — так туннель проходит сквозь сети, где открыт только 443.
	servers {
		protocols {$SO101_HTTP_PROTOCOLS:h1 h2 h3}
	}
}

{$SO101_SITE} {
	encode zstd gzip

	# ── АДМИНКА НАРУЖУ НЕ ВЫХОДИТ ─────────────────────────────────────────
	# /api/admin/* — это аварийная остановка, снятие оператора и полный список
	# очереди с токенами. Токен там есть, но публиковать эти адреса незачем:
	# оператор пользуется ими со стенда, по локальной сети.
	# Отдаём 404, а не 403: наружу не должно быть видно даже того, что они есть.
	handle /api/admin/* {
		respond "404 page not found" 404
	}

	# ── всё остальное — на стенд ──────────────────────────────────────────
	handle {
		reverse_proxy {$SO101_UPSTREAM:10.8.0.2:8080} {
			# flush_interval -1 ОБЯЗАТЕЛЕН. Видео идёт бесконечным
			# multipart-потоком, и при буферизации картинка либо появляется
			# через минуту, либо не появляется вовсе. Тот же смысл, что
			# `proxy_buffering off` в nginx стенда.
			flush_interval -1

			# Схема, как её видел браузер. Шлюз смотрит на этот заголовок и
			# по нему решает, ставить ли флаг Secure у cookie сессии. За TLS
			# соединение до стенда идёт по http, и без подстановки cookie
			# осталась бы без Secure.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}

			# Стенд не отвечает дольше секунды — считаем, что он не на связи,
			# и показываем страницу вместо того, чтобы держать посетителя.
			transport http {
				dial_timeout 2s
				# Ответ не ограничиваем: видео и WebSocket живут часами.
				response_header_timeout 10s
			}
		}
	}

	# ── стенд не на связи ─────────────────────────────────────────────────
	# Туннель опущен (публичный доступ выключен) либо стенд обесточен.
	# Посетитель, пришедший по QR, должен увидеть внятную страницу, а не
	# «502 Bad Gateway»: по второму он решит, что сломан его телефон.
	handle_errors {
		@down expression {err.status_code} in [502, 503, 504]
		handle @down {
			root * /var/www/so101
			rewrite * /offline.html
			# 503, а не 502: «плохой шлюз» тут неправда — стенд не сломан,
			# он выключен. Retry-After говорит поисковикам и браузерам, что
			# это временно, и страницу не надо запоминать как ошибку.
			header Retry-After "300"
			file_server {
				status 503
			}
		}
		respond "{err.status_code}"
	}
}
