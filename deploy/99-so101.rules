# udev-правила демо-стенда SO-101.
#
#   sudo cp deploy/99-so101.rules /etc/udev/rules.d/99-so101.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -l /dev/so101_follower /dev/so101_camera
#
# ЗАЧЕМ. `/dev/ttyACM0` — не имя, а номер очереди: он меняется от того, в каком
# порядке загрузились драйверы, и после каждого передёргивания кабеля. Стенд,
# поднятый вечером, утром не находит руку. Launch-файл апстрима по умолчанию
# ждёт именно `/dev/so101_follower` (аргумент usb_port в follower.launch.py),
# а deploy/compose.prod.yml пробрасывает в контейнер этот же путь.
#
# ЧЕМ ОТЛИЧАЕТСЯ ОТ ШАБЛОНА АПСТРИМА (upstream/docs/assets/99-so101.rules.example).
# Там правила рассчитаны на пару «лидер + фоллоуер» и различают их по серийному
# номеру, поэтому файл нельзя применить не отредактировав. На демо-стенде рука
# ОДНА, ведущей руки нет вообще, и камера тоже одна — значит, различать некого,
# и хватает совпадения по «это переходник Feetech». Файл кладётся как есть.
#
# Если на стенде окажется больше одного USB-переходника (например, привезли
# ведущую руку для отладки), правило станет неоднозначным — тогда добавьте
# ENV{ID_SERIAL_SHORT}, как показано в закомментированной строке ниже.
# Узнать значения:
#     udevadm info --query=property --name=/dev/ttyACM0 | \
#       egrep 'ID_VENDOR_ID|ID_MODEL_ID|ID_SERIAL_SHORT|ID_PATH'

# ── Рука ────────────────────────────────────────────────────────────────────
# Плата управления сервоприводами Feetech встречается на четырёх разных
# USB-UART микросхемах — какая именно достанется, зависит от партии. Перечислены
# все четыре; лишние строки просто не сработают.
#
#   1a86:55d3  CH343  (плата Waveshare Serial Bus Servo Driver, самый частый случай)
#   1a86:7523  CH340
#   10c4:ea60  CP2102
#   0403:6001  FTDI FT232

SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="55d3", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="7523", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="10c4", ENV{ID_MODEL_ID}=="ea60", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="6001", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"

# Точный вариант — когда переходников несколько. Подставьте свой серийный номер
# и УДАЛИТЕ четыре строки выше, иначе симлинк достанется тому, кто подключился
# первым.
# SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="55d3", ENV{ID_SERIAL_SHORT}=="ВАШ_СЕРИЙНЫЙ", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"

# ── Камера ──────────────────────────────────────────────────────────────────
# Два симлинка на одно устройство: `so101_camera` ждёт deploy/compose.prod.yml,
# `cam_overhead` — конфиги камер апстрима (so101_cameras.yaml). Так работает
# и наш узел, и камерный стек апстрима, без правки конфигов.
#
# ATTR{index}=="0" обязателен: UVC-камера регистрирует ДВА узла /dev/video*,
# второй отдаёт метаданные, а не картинку. Без этого условия симлинк с
# вероятностью примерно один к двум укажет на узел, из которого никогда не
# придёт ни одного кадра, — и это выглядит как «камера подключена, видео нет».

ACTION=="add|change", SUBSYSTEM=="video4linux", KERNEL=="video*", ATTR{index}=="0", SUBSYSTEMS=="usb", SYMLINK+="so101_camera", SYMLINK+="cam_overhead", GROUP="video", MODE="0660"

# Если камер на стенде окажется две (обзорная и на запястье) — различайте по
# серийному номеру, как в шаблоне апстрима:
# ACTION=="add|change", SUBSYSTEM=="video4linux", KERNEL=="video*", ENV{ID_SERIAL_SHORT}=="СЕРИЙНЫЙ_ОБЗОРНОЙ", ATTR{index}=="0", SYMLINK+="so101_camera", SYMLINK+="cam_overhead", GROUP="video", MODE="0660"

# ── ЛОВУШКА DOCKER, о ней помнить ───────────────────────────────────────────
# `devices:` в compose передаёт в контейнер устройство ПО НОМЕРУ (major:minor),
# который выясняется в момент старта контейнера. Если после этого выдернуть и
# воткнуть кабель, ядро выдаст устройству новый номер: снаружи симлинк
# починится сам, а внутри контейнера останется мёртвый узел — рука «есть в
# /dev, но не отвечает». Лечение — перезапуск стека целиком, см. docs/runbook.md.
